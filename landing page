.time input{width:90px;accent-color:currentColor}
.time button{font:inherit;color:inherit;background:none;border:1.5px solid currentColor;border-radius:999px;padding:0 .6rem;cursor:pointer}
.time button:focus-visible,.time input:focus-visible{outline:2px solid currentColor;outline-offset:3px}
</style>
</head>
<body>
<canvas id="fog" aria-hidden="true"></canvas>
<main>
  <section class="hero">
    <h1 class="sr">hi, i’m sage park</h1>
    <p class="sub">i’m a human centered designer based in st. louis and san diego.</p>
    <p class="hint">draw on the window</p>
  </section>
</main>
<div class="time">
  <span id="tl">Central Time</span>
  <input id="t" type="range" min="0" max="1439" step="1" aria-label="Preview time of day in Central Time">
  <button id="live" type="button">Live</button>
</div>
